[Unit]
Description=CouchPotato application instance
After=network.target

[Service]
Type=simple
User=couchpotato
Group=couchpotato
WorkingDirectory=/var/lib/CouchPotatoServer
ExecStart=/var/lib/CouchPotatoServer/.venv/bin/python /var/lib/CouchPotatoServer/CouchPotato.py
Restart=always
RestartSec=5s
SyslogIdentifier=couchpotato
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
